/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' https://adrien-assets.brage.fr; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none';

# Shared by link only. Kept out of robots.txt on purpose: that file is public
# and listing the path there would advertise what it is meant to hide.
/cv/*
  X-Robots-Tag: noindex, nofollow, noarchive
